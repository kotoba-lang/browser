(ns browser.native-snapshot-test
  (:require [browser.local-session :as session] [browser.local-snapshot :as snapshot])
  (:export [main]))
(defn f [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn at [d :document i :i64] :document (option-or (document-vector-at d i) (document-null)))
(defn txt [d :document] :string (option-or (document-string-value d) ""))
(defn num [d :document] :i64 (option-or (document-i64-value d) 0))
(defn denied? [v :document] :bool (not (option-some?-of [:option :document] (snapshot/restore v "local"))))
(defn long-url [] :string
  (loop [i 0 out ""]
    (if (= i 16) out (recur (+ i 1) (string-concat out "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")))))
(defn history-many [url :string n :i64] :document
  (loop [i 0 out (document-vector)]
    (if (= i n) out (recur (+ i 1) (document-vector-conj out (document-string url))))))
(defn main [] :i64
  (let [a (session/open-tab (session/empty-session "original") "https://one.example/a")
        b (session/confirm-navigation a "tab-1" 1 "https://one.example/a")
        c (session/confirm-navigation (session/commit-address (session/set-address b "https://one.example/b")) "tab-1" 2 "https://one.example/b")
        d (session/open-tab c "https://two.example/")
        e (session/confirm-navigation d "tab-2" 3 "https://two.example/")
        focused (session/focus-tab e "tab-1")
        cached (session/remember-html-page focused "tab-1" "https://one.example/b" "private-page-wire")
        stored (session/put-value cached (document-keyword :secret) (document-string "private-store-value"))
        pending (session/commit-address (session/set-address stored "https://pending.example/"))
        opt (snapshot/snapshot pending) saved (option-or opt (document-null))
        wire (document-edn-print saved) decoded (document-edn-read wire)
        recovered (snapshot/restore decoded "restored") state (option-or recovered (document-null))
        tabs (f (f state :session/chrome) :chrome/tabs) first (at tabs 0) second (at tabs 1)
        reopened (session/open-tab state "") back (session/request-history state -1)
        no-tabs (snapshot/snapshot (session/empty-session "local"))
        bad-active (document-assoc saved :snapshot/active (document-i64 9))
        bad-version (document-assoc saved :snapshot/version (document-i64 2))
        bad-generation (document-assoc saved :snapshot/next-generation (document-i64 0))
        bad-tabs (document-assoc saved :snapshot/tabs (document-string "not tabs"))
        invalid-tab (document-assoc (at (f saved :snapshot/tabs) 0) :index (document-i64 31))
        invalid-history (document-assoc saved :snapshot/tabs (document-vector invalid-tab))
        bad-url-tab (document-assoc (at (f saved :snapshot/tabs) 0) :url (document-string "https://bad/\n"))
        bad-url (document-assoc saved :snapshot/tabs (document-vector bad-url-tab))
        long (long-url) oversized-tab (document-map :url (document-string long) :title (document-string "")
                           :history (history-many long 17) :index (document-i64 0))
        oversized (document-assoc saved :snapshot/tabs (document-vector oversized-tab))
        extra (document-assoc saved :unexpected (document-bool true))
        late (session/confirm-navigation state "tab-1" 4 "https://pending.example/")]
    (if (and (option-some?-of [:option :document] opt) (document-equal? saved decoded)
             (option-some?-of [:option :document] recovered)
             (string=? (txt (f state :session/partition)) "restored")
             (= (document-count tabs) 2) (string=? (txt (f first :tab/url)) "https://one.example/b")
             (= (num (f first :tab/history-index)) 1) (= (document-count (f first :tab/history)) 2)
             (string=? (txt (f second :tab/url)) "https://two.example/")
             (string=? (session/active-url state) "https://one.example/b")
             (= (session/pending-generation state "tab-1") 0)
             (= (document-count (f state :session/store)) 0)
             (= (document-count (f state :session/html-pages)) 0)
             (not (string-contains? (document-edn-print saved) "private-store-value"))
             (not (string-contains? (document-edn-print saved) "private-page-wire"))
             (document-equal? late state)
             (= (num (f state :session/next-generation)) 5)
             (= (session/pending-generation back "tab-1") 5)
             (string=? (txt (f (f reopened :session/chrome) :chrome/active-tab-id)) "tab-3")
             (option-some?-of [:option :document] no-tabs)
             (option-some?-of [:option :document] (snapshot/restore (option-or no-tabs (document-null)) "local"))
             (denied? bad-active) (denied? bad-version) (denied? bad-generation) (denied? bad-tabs)
             (denied? invalid-history) (denied? bad-url) (denied? oversized) (denied? extra)
             (not (option-some?-of [:option :document] (snapshot/restore saved "")))) 0 1)))
