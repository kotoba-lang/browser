(ns browser.native-html-navigation-test
  (:require [browser.local-session :as session] [browser.local-html-navigation :as nav])
  (:capabilities [:io/write])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn kind [d :document] :keyword (option-or (document-keyword-value (field d :kind)) :bad))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn rejected? [r :document original :document expected :keyword] :bool
  (and (= (kind r) expected) (document-equal? (field r :session) original) (= (document-kind (field r :wire)) :null)))
(defn main [] :i64
  (let [url "https://one.example/" body "<section><h1>Hi <em>世界</em></h1><p><strong>重要</strong> <code>x</code></section>"
        state (session/open-tab (session/empty-session "local") url)
        wrong-generation (nav/prepare state "tab-1" 2 url body)
        wrong-tab (nav/prepare state "tab-2" 1 url body)
        redirect (nav/prepare state "tab-1" 1 "https://other.example/" body)
        invalid (nav/prepare state "tab-1" 1 url "<script>bad</script>")
        document-page (nav/prepare state "tab-1" 1 url "<!doctype html><html><head><title>猫\r\n犬</title></head><body><p>page\r\ntext</p></body></html>")
        document-tab (option-or (document-vector-at (field (field (field document-page :session) :session/chrome) :chrome/tabs) 0) (document-null))
        bad-head (nav/prepare state "tab-1" 1 url "<!doctype html><html><head><meta http-equiv='refresh' content='0'></head><body>x</body></html>")
        ;; The native document tree-value projection traps at this depth;
        ;; navigation must instead preserve the complete flat operation wire.
        deep (nav/prepare state "tab-1" 1 url "<div><div><div><div><div>deep</div></div></div></div></div>")
        ok (nav/prepare state "tab-1" 1 url body)
        next (field ok :session) wire (text (field ok :wire))
        replay (nav/prepare next "tab-1" 1 url body)
        bg-url "https://two.example/" bg-state (session/focus-tab (session/open-tab next bg-url) "tab-1")
        bg (nav/prepare bg-state "tab-2" 2 bg-url "<p>two</p>")
        bg-result (field bg :session) bg-wire (text (field bg :wire))
        bg-focused (session/focus-tab bg-result "tab-2")
        edited (session/address-insert bg-result "x")
        closed (session/close-tab bg-focused "tab-2")
        next-url "https://one.example/next"
        pending (session/commit-address (session/set-address closed next-url))
        plain (session/confirm-navigation pending "tab-1" 3 next-url)]
    (if (not (and (rejected? wrong-generation state :html-navigation/stale)
                  (rejected? wrong-tab state :html-navigation/stale)
                  (rejected? redirect state :html-navigation/stale)
                  (rejected? invalid state :html-navigation/unsupported)
                  (rejected? bad-head state :html-navigation/unsupported)
                  (= (kind document-page) :html-navigation/ok)
                  (string=? (text (field document-tab :tab/title)) "猫\n犬")
                  (= (kind deep) :html-navigation/ok) (> (string-length (text (field deep :wire))) 0)
                  (= (kind ok) :html-navigation/ok) (= (session/pending-generation next "tab-1") 0)
                  (string=? (session/active-url next) url) (> (string-length wire) 0)
                  (rejected? replay next :html-navigation/stale)
                  (= (kind bg) :html-navigation/ok) (string=? (session/active-url bg-result) url)
                  (string=? (session/active-url bg-focused) bg-url)
                  (string=? (option-or (session/active-html-page bg-result) "") wire)
                  (string=? (option-or (session/active-html-page bg-focused) "") bg-wire)
                  (not (string=? bg-wire wire))
                  (string=? (option-or (session/active-html-page edited) "") wire)
                  (string=? (option-or (session/active-html-page closed) "") wire)
                  (= (document-count (field closed :session/html-pages)) 1)
                  (string=? (option-or (session/active-html-page pending) "") wire)
                  (not (option-some?-of [:option :string] (session/active-html-page plain))))) 1
      (let [sent (typed-cap-call :io/write :string :string (string-concat "PAGE " (string-concat wire "\n")))] 0))))
