(ns browser.native-local-loop-test
  (:require [browser.local-session :as session]
            [browser.local-loop :as runtime]
            [browser.local-event-wire :as input])
  (:export [main]))

(defn field [d :document key :keyword] :document
  (option-or (document-get d key) (document-null)))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn frame [value [:option :document]] :document (option-or value (document-null)))
(defn present? [value [:option :document]] :bool (option-some?-of [:option :document] value))

(defn main [] :i64
  (let [f0 (frame (runtime/begin (session/empty-session "p") 1))
        opened (runtime/step f0 1 "B1|:ui/click|3|-1|-1|0|0|")
        f1 (frame opened)
        typed (runtime/step f1 2 "B1|:ui/text|9|0|0|0|0|A😀B")
        f2 (frame typed)
        selected (runtime/step f2 3 "B1|:ui/text|9|3|1|0|0|X")
        f3 (frame selected)
        submitted (frame (runtime/step f3 4 "B1|:ui/submit|9|-1|-1|0|0|"))
        notice (field submitted :navigation)
        after-edit (frame (runtime/step submitted 5 "B1|:ui/text|9|-1|-1|0|0|!"))
        output (text (field (field (field f3 :state) :session/address-editor) :text/value))
        stale (runtime/step f2 2 "B1|:ui/text|9|0|0|0|0|wrong")
        malformed (input/decode "B1|:ui/text|09|0|0|0|0|bad")
        broken (input/decode "B1|:ui/text|9|0|0|0|0")
        movement (input/decode "B1|:ui/text|9|0|0|1|0|bad")
        escaped (input/decode "B1|:ui/text|9|-1|-1|0|0|a|b\n日本")]
    (cond (not (present? opened)) 1
          (not (present? typed)) 2
          (not (present? selected)) 3
          (not (string=? output "AXB")) 4
          (present? stale) 5
          (or (present? malformed) (present? broken) (present? movement)) 6
          (not (string=? (text (field (frame escaped) :text)) "a|b\n日本")) 7
          (not= (option-or (document-i64-value (field f3 :revision)) 0) 4) 8
          (not (string=? (text (field notice :tab)) "tab-1")) 9
          (not (string=? (text (field notice :url)) "AXB")) 10
          (not= (option-or (document-i64-value (field notice :generation)) 0) 1) 11
          (not= (document-kind (field after-edit :navigation)) :null) 12
          :else 0)))
