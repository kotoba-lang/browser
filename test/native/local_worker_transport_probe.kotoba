;; Test-only protocol probe, not the Browser actor.
(defn main [] :i64
  (let [frame (typed-cap-call :io/write :string :string "FRAME 1 422\n[[[\":dom/create-element\",1,\":main\"],[\":dom/set-root\",1],[\":dom/create-element\",2,\":input\"],[\":dom/set-attr\",2,\":data-role\",\"address\"],[\":dom/set-attr\",2,\":value\",\"\"],[\":dom/set-attr\",2,\":data-selection-start\",0],[\":dom/set-attr\",2,\":data-selection-end\",0],[\":dom/set-attr\",2,\":data-caret\",0],[\":dom/append-child\",1,2],[\":dom/create-element\",3,\":section\"],[\":dom/set-attr\",3,\":data-role\",\"page\"],[\":dom/append-child\",1,3]]]")
        flush1 (typed-cap-call :io/write-error :string :string "")
        request (typed-cap-call :io/read :string :string "6")
        response (if (string=? request "4\nS1|1") "SFRAME 1 6\nBSS1|x" "REJECT\n")
        sent (typed-cap-call :io/write :string :string response)
        flush2 (typed-cap-call :io/write-error :string :string "")
        close (typed-cap-call :io/read :string :string "2")]
    (if (and (string=? request "4\nS1|1") (string=? close "0\n")) 0 1)))
