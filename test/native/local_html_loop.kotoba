(ns browser.native-html-loop-test
  (:require [browser.local-session :as session] [browser.local-loop :as runtime] [browser.local-html-loop :as html])
  (:capabilities [:io/write])
  (:export [main]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn num [d :document] :i64 (option-or (document-i64-value d) 0))
(defn text [d :document] :string (option-or (document-string-value d) ""))
(defn main [] :i64
  (let [url "https://one.example/" body "<section><h1>Hi <em>世界</em></h1><p><strong>重要</strong> <code>x</code></p></section>"
        state (session/open-tab (session/empty-session "local") url)
        initial (runtime/begin state 10) frame (option-or initial (document-null))
        stale (html/prepare frame 9 "tab-1" 1 url body)
        old (html/prepare frame 10 "tab-1" 2 url body)
        bad (html/prepare frame 10 "tab-1" 1 url "<script>bad</script>")
        ok (html/prepare frame 10 "tab-1" 1 url body)
        result (option-or ok (document-null)) next (field result :frame)
        wire (text (field result :page-wire)) next-state (field next :state)]
    (if (not (and (option-some?-of [:option :document] initial)
                  (not (option-some?-of [:option :document] stale))
                  (not (option-some?-of [:option :document] old))
                  (not (option-some?-of [:option :document] bad))
                  (option-some?-of [:option :document] ok) (= (num (field next :revision)) 11)
                  (string=? (session/active-url next-state) url)
                  (= (session/pending-generation next-state "tab-1") 0)
                  (> (string-length (text (field next :wire))) 0)
                  (> (string-length wire) 0))) 1
      (let [sent (typed-cap-call :io/write :string :string (string-concat "PAGE " (string-concat wire "\n")))] 0))))
