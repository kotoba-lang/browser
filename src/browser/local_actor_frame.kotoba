(ns browser.local-actor-frame
  (:capabilities [:io/write :io/write-error])
  (:export [emit-frame]))
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn emit-frame [frame :document] :i64
  (let [revision (option-or (document-i64-value (field frame :revision)) 0)
        wire (option-or (document-string-value (field frame :wire)) "")
        page (option-or (document-string-value (field frame :page-wire)) "")
        prefix (if (string=? page "") "FRAME " "PFRAME ")
        suffix (if (string=? page "") "" (string-concat " " (string-from-i64 (string-byte-length page))))
        header (string-concat prefix (string-concat (string-from-i64 revision)
                 (string-concat " " (string-concat (string-from-i64 (string-byte-length wire))
                   (string-concat suffix "\n")))))
        out (typed-cap-call :io/write :string :string (string-concat header (string-concat wire page)))
        flush (typed-cap-call :io/write-error :string :string "")]
    0))
