(ns browser.local-html-loop
  (:require [browser.local-loop :as runtime] [browser.local-html-navigation :as nav]
            [browser.local-session :as session])
  (:export [prepare cancel link]))

;; Prepare a shell frame and page wire together; the caller must authenticate
;; and approve the response, then commit both as one host transaction. This
;; function does not fetch, apply operations, or supply an approval.
(defn field [d :document k :keyword] :document (option-or (document-get d k) (document-null)))
(defn integer [d :document] :i64 (option-or (document-i64-value d) 0))
(defn kind [d :document] :keyword (option-or (document-keyword-value d) :bad))
(defn link [frame :document expected :i64 tab :string url :string] [:option :document]
  ;; The host authenticates the actor channel, verifies the current rendered
  ;; page gesture, and resolves the URL. This does not authorize a request.
  (let [revision (integer (field frame :revision)) state (field frame :state)]
    (if (or (< revision 1) (>= revision 9007199254740991) (not= expected revision)
            (not (= (string-index-of url "https://") 0)) (> (string-byte-length url) 4096))
      (option-none-of [:option :document])
      (let [next-state (session/request-link state tab url)]
        (if (document-equal? next-state state) (option-none-of [:option :document])
          (let [next (runtime/begin next-state (+ revision 1))]
            (if (not (option-some?-of [:option :document] next)) next
              (option-some-of [:option :document]
                (document-assoc (option-or next (document-null)) :navigation (runtime/new-navigation state next-state))))))))))
(defn cancel [frame :document expected :i64 tab :string generation :i64] [:option :document]
  ;; Only an exact pending generation in the exact current frame may be
  ;; cancelled. This changes local state and cannot authorize an operation.
  (let [revision (integer (field frame :revision)) state (field frame :state)]
    (if (or (< revision 1) (>= revision 9007199254740991) (not= revision expected)
            (<= generation 0) (not= generation (session/pending-generation state tab)))
      (option-none-of [:option :document])
      (runtime/begin (session/cancel-navigation state tab generation) (+ revision 1)))))
(defn prepare [frame :document expected :i64 tab :string generation :i64 url :string body :string] [:option :document]
  (let [revision (integer (field frame :revision))]
    (if (or (< revision 1) (>= revision 9007199254740991) (not= revision expected))
      (option-none-of [:option :document])
      (let [prepared (nav/prepare (field frame :state) tab generation url body)]
        (if (not= (kind (field prepared :kind)) :html-navigation/ok)
          (option-none-of [:option :document])
          (let [next (runtime/begin (field prepared :session) (+ revision 1))]
            (if (not (option-some?-of [:option :document] next))
              (option-none-of [:option :document])
              (option-some-of [:option :document]
                (document-map :frame (option-or next (document-null)) :page-wire (field (option-or next (document-null)) :page-wire)
                              :tab (document-string tab) :generation (document-i64 generation))))))))))
