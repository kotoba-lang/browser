(ns browser.local-html-actor
  (:require [browser.local-session :as session]
            [browser.local-loop :as runtime]
            [browser.local-html-loop :as html]
            [browser.local-actor-frame :as emitter])
  (:capabilities [:io/read :io/write :io/write-error])
  (:export [main]))

;; Experimental local transport. The host must authenticate this channel,
;; verify response provenance/MIME/size and obtain fresh operation consent.
;; H1 carries already-supplied HTML only; it grants no network capability.
;; H1|revision|generation|tab|url-byte-length|<url><html> is length framed.
;; NFRAME reports a newly queued navigation to the trusted host; it conveys
;; no consent and is valid only on the authenticated actor channel.
;; Other inputs retain the native actor's revision|B1 UI event format.
(defn field [d :document key :keyword] :document
  (option-or (document-get d key) (document-null)))
(defn read-one [] :string (typed-cap-call :io/read :string :string "1"))
(defn write-flush [s :string] :i64
  (let [out (typed-cap-call :io/write :string :string s)
        flush (typed-cap-call :io/write-error :string :string "")]
    0))

;; -1 is clean EOF, -2 is a malformed or truncated length header.
(defn read-length [value :i64 digits :i64] :i64
  (let [s (read-one)]
    (cond (string=? s "") (if (= digits 0) -1 -2)
          (string=? s "\n") (cond (= digits 0) -2 (= value 0) -1 (> value 65700) -2 :else value)
          (or (not= (string-byte-length s) 1) (>= digits 5)) -2
          :else (let [c (string-code-point-at s 0)]
                  (if (or (< c 48) (> c 57) (and (> digits 0) (= value 0))) -2
                    (read-length (+ (* value 10) (- c 48)) (+ digits 1)))))))

(defn read-body [remaining :i64 out :string] [:option :string]
  (if (= remaining 0) (option-some-of [:option :string] out)
    (let [s (read-one) n (string-byte-length s)]
      (if (or (= n 0) (> n remaining)) (option-none-of [:option :string])
        (read-body (- remaining n) (string-concat out s))))))

;; Bounded decimal revision before the first delimiter; 0 means invalid.
(defn parse-revision [s :string end :i64] :i64
  (if (or (< end 1) (> end 16) (and (> end 1) (= (string-code-point-at s 0) 48))) 0
    (loop [i 0 value 0]
      (if (= i end) (if (<= value 9007199254740991) value 0)
        (let [c (string-code-point-at s i)]
          (if (or (< c 48) (> c 57)) 0 (recur (+ i 1) (+ (* value 10) (- c 48)))))))))

(defn scalar-width [cp :i64] :i64
  (cond (< cp 128) 1 (< cp 2048) 2 (< cp 65536) 3 :else 4))
(defn boundary? [s :string i :i64 end :i64] :bool
  (cond (= i end) true (> i end) false (>= i (string-length s)) false
        :else (boundary? s (+ i (scalar-width (string-code-point-at s i))) end)))
(defn split [s :string] :document
  (let [at (string-index-of s "|")]
    (if (< at 0) (document-null)
      (document-vector (document-string (string-substring s 0 at))
                       (document-string (string-substring s (+ at 1) (string-length s)))))))
(defn item [d :document i :i64] :string
  (if (= (document-kind d) :vector)
    (option-or (document-string-value (option-or (document-vector-at d i) (document-null))) "") ""))
(defn number [s :string] :i64 (parse-revision s (string-length s)))
(defn response [frame :document raw :string] [:option :document]
  (let [r (split raw) a (split (item r 1)) b (split (item a 1)) c (split (item b 1))
        revision (number (item r 0)) generation (number (item a 0)) tab (item b 0)
        size (number (item c 0)) payload (item c 1)]
    (if (or (= (document-kind r) :null) (= (document-kind a) :null)
            (= (document-kind b) :null) (= (document-kind c) :null)
            (<= size 0) (> size 4096) (> size (string-length payload))
            (not (boundary? payload 0 size)) (string=? tab ""))
      (option-none-of [:option :document])
      (let [url (string-substring payload 0 size) body (string-substring payload size (string-length payload))
            result (html/prepare frame revision tab generation url body)]
        (if (option-some?-of [:option :document] result)
          (option-some-of [:option :document] (field (option-or result (document-null)) :frame))
          (option-none-of [:option :document]))))))
(defn serve [frame :document] :i64
  (let [length (read-length 0 0)]
    (cond (= length -1) 0
          (< length 0) 2
          :else (let [body (read-body length "")]
                  (if (not (option-some?-of [:option :string] body)) 2
                    (let [s (option-or body "") is-html (= (string-index-of s "H1|") 0)
                          separator (string-index-of s "|")
                          revision (if (< separator 0) 0 (parse-revision s separator))
                          event (if (< separator 0) "" (string-substring s (+ separator 1) (string-length s)))
                          next (if is-html (response frame (string-substring s 3 (string-length s)))
                                 (runtime/step frame revision event))]
                      (if (option-some?-of [:option :document] next)
                        (let [f (option-or next (document-null)) sent (emitter/emit-html-frame f)] (serve f))
                        (let [sent (write-flush "REJECT\n")] (serve frame)))))))))

(defn main [] :i64
  (let [initial (runtime/begin (session/empty-session "local") 1)]
    (if (not (option-some?-of [:option :document] initial)) 1
      (let [frame (option-or initial (document-null)) sent (emitter/emit-html-frame frame)] (serve frame)))))
