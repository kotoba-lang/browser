{
  "schema": "kotoba.browser.webext-conformance.v1",
  "adr": "docs/adr/0003-brave-class-web-compatible-browser.md",
  "status": "proposed with ADR-0003; frozen when the ADR is accepted",
  "outcomes": {
    "install-admit": "manifest maps to a client-runtime descriptor and is shown for approval",
    "install-refuse": "manifest is refused before any descriptor approval",
    "allow-declared": "Ruling 2 tier 1: declared read or extension-local call inside the approved scope; audited, no fresh prompt",
    "consent-required": "Ruling 2 tier 2: fresh per-operation consent immediately before invocation",
    "refuse": "fails closed; no grant, no proxy"
  },
  "cases": [
    {"id": "P01-runtime-getURL", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.runtime", "method": "getURL", "args": ["options.html"]},
     "expect": {"outcome": "allow-declared", "requestsSent": 0}},
    {"id": "P02-runtime-sendMessage", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.runtime", "method": "sendMessage", "args": [{"type": "read-consent"}]},
     "expect": {"outcome": "allow-declared", "requestsSent": 0, "note": "delivered to the extension's own onMessage listener only"}},
    {"id": "P03-storage-local-get", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.storage.local", "method": "get", "args": ["vendors"]},
     "expect": {"outcome": "allow-declared", "requestsSent": 0}},
    {"id": "P04-storage-local-set", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.storage.local", "method": "set", "args": [{"vendors": []}]},
     "expect": {"outcome": "allow-declared", "requestsSent": 0, "note": "extension-local state; not in the ADR's state-changing list"}},
    {"id": "P05-tabs-query-declared", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.tabs", "method": "query", "args": [{"url": "https://news.example/*"}]},
     "expect": {"outcome": "allow-declared", "requestsSent": 0, "resultScope": "tabs matching the declared pattern only"}},
    {"id": "P06-tabs-create", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.tabs", "method": "create", "args": [{"url": "https://news.example/privacy"}]},
     "consent": "approve",
     "expect": {"outcome": "consent-required", "executed": true}},
    {"id": "P07-cookies-get-approved-origin", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.cookies", "method": "get", "args": [{"url": "https://news.example/", "name": "euconsent-v2"}]},
     "expect": {"outcome": "allow-declared", "requestsSent": 0}},
    {"id": "P08-cookies-set-approved-origin", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.cookies", "method": "set", "args": [{"url": "https://news.example/", "name": "euconsent-v2", "value": "deny-all"}]},
     "consent": "approve",
     "expect": {"outcome": "consent-required", "executed": true}},
    {"id": "P09-scripting-executeScript-declared", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.scripting", "method": "executeScript", "args": [{"target": {"url": "https://news.example/article"}, "files": ["content.js"]}]},
     "consent": "approve",
     "expect": {"outcome": "consent-required", "executed": true}},

    {"id": "N01-undeclared-origin", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.cookies", "method": "get", "args": [{"url": "https://ads.example/", "name": "id"}]},
     "expect": {"outcome": "refuse", "reason": "origin-not-declared", "requestsSent": 0}},
    {"id": "N02-undeclared-permission", "manifest": "manifests/no-cookies.json",
     "call": {"namespace": "chrome.cookies", "method": "get", "args": [{"url": "https://news.example/", "name": "euconsent-v2"}]},
     "expect": {"outcome": "refuse", "reason": "permission-not-declared", "requestsSent": 0}},
    {"id": "N03-overscoped-tabs-query", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.tabs", "method": "query", "args": [{}]},
     "expect": {"outcome": "refuse", "reason": "query-exceeds-declared-matches", "requestsSent": 0}},
    {"id": "N04-deny-then-network", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.cookies", "method": "set", "args": [{"url": "https://news.example/", "name": "euconsent-v2", "value": "deny-all"}]},
     "consent": "deny",
     "expect": {"outcome": "consent-required", "executed": false, "requestsSent": 0}},
    {"id": "N05-undeclared-namespace", "manifest": "manifests/cmp-reader.json",
     "call": {"namespace": "chrome.history", "method": "search", "args": [{"text": ""}]},
     "expect": {"outcome": "refuse", "reason": "namespace-outside-v1-slice", "requestsSent": 0}},
    {"id": "N06-manifest-v2", "manifest": "manifests/mv2.json",
     "install": true,
     "expect": {"outcome": "install-refuse", "reason": "manifest_version-not-3"}},
    {"id": "N07-dnr-runtime-rule", "manifest": "manifests/dnr.json",
     "call": {"namespace": "chrome.declarativeNetRequest", "method": "updateDynamicRules", "args": [{"addRules": [{"id": 1, "action": {"type": "block"}, "condition": {"urlFilter": "ads"}}]}]},
     "expect": {"outcome": "refuse", "reason": "no-runtime-request-rewriting", "requestsSent": 0}},
    {"id": "N08-install-prompt-is-not-consent", "manifest": "manifests/cmp-reader.json",
     "installApproved": true,
     "call": {"namespace": "chrome.cookies", "method": "remove", "args": [{"url": "https://news.example/", "name": "euconsent-v2"}]},
     "consent": "none",
     "expect": {"outcome": "consent-required", "executed": false, "requestsSent": 0, "note": "install approval alone never authorizes a tier-2 call"}},

    {"id": "I01-install-cmp-reader", "manifest": "manifests/cmp-reader.json",
     "install": true,
     "expect": {"outcome": "install-admit",
                "descriptor": {"namespaces": ["chrome.runtime", "chrome.storage", "chrome.tabs", "chrome.cookies", "chrome.scripting"],
                               "endpointOrigins": ["https://news.example"],
                               "dataCategories": ["storage", "cookies", "tabs", "scripting"]}}}
  ],
  "openRuling": {
    "tier1": "Cases with outcome allow-declared touching cookies or tabs (P05, P07) follow ADR-0003 Ruling 2 tier 1. The canonical broker (kotoba-lang/wasm-webcomponent src/kotoba-client-runtime.js, main) accepts only consent 'each-operation' for every declared operation, so those cases need either a host-local (non-broker) tier for declared reads or a change to expect consent-required. Decide on ADR acceptance; the corpus freezes with that decision."
  }
}
