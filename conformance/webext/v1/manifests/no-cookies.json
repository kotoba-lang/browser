{
  "manifest_version": 3,
  "name": "no-cookies fixture",
  "version": "1.0.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://news.example/*"],
  "content_scripts": [{"matches": ["https://news.example/*"], "js": ["content.js"]}],
  "background": {"service_worker": "background.js"}
}
